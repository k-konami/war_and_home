#. [message]: speaker=unit
#: war_and_home/utils/deaths.cfg:28
msgid "Sorry everyone..."
msgstr "すまない、同志たちよ..."

#. [message]: speaker=unit
#: war_and_home/utils/deaths.cfg:44
msgid "Ouch... sorry..."
msgstr "痛い...ごめんね..."

#. [message]: speaker=unit
#: war_and_home/utils/deaths.cfg:60
msgid "I fear I shan't make it..."
msgstr "もう駄目かもしれません..."

#. [message]: speaker=unit
#: war_and_home/utils/deaths.cfg:76
msgid "Impossible!"
msgstr "無理！"

#. [message]: speaker=unit
#: war_and_home/utils/deaths.cfg:92
msgid "No! My people!"
msgstr "なんてことだ！ ああ、我が民たちよ！"

#. [message]: speaker=unit
#: war_and_home/utils/deaths.cfg:108
msgid "Sorry father, mother, I fear I shall be the one going first instead..."
msgstr "ごめんよ、父さん、母さん、先立つことになりそう...だ..."

#. [message]: speaker=unit
#: war_and_home/utils/deaths.cfg:124
msgid "Alas, I will not be able to fulfill my oath."
msgstr "残念なことに、私は誓いを果たすことができそうにありません。"

#. [message]: speaker=unit
#: war_and_home/utils/deaths.cfg:140
msgid "Fate seems to enjoy its reversals... Goodbye, my love..."
msgstr "運命は逆転を楽しんでいるようだ... さようなら、愛する人よ..."

#. [message]: speaker=unit
#: war_and_home/utils/deaths.cfg:156
msgid "As fate has planned it..."
msgstr "「運命のいたずら」なのでしょうか..."

#. [message]: speaker=unit
#: war_and_home/utils/deaths.cfg:172
msgid "Woof woo— ..."
msgstr "ウーー ウー..."

#. [message]: speaker=unit
#: war_and_home/utils/deaths.cfg:188
msgid "I—I'm scared..."
msgstr "私...怖いです..."

#. [message]: speaker=unit
#: war_and_home/utils/deaths.cfg:204
msgid "I have served, maybe now I shall sleep..."
msgstr "私はお仕えしました、もう眠りにつく時間です..."

#. [message]: speaker=unit
#: war_and_home/utils/deaths.cfg:220
msgid "Fall ba—!"
msgstr "陥落する...！"

#. [message]: speaker=unit
#: war_and_home/utils/deaths.cfg:236
msgid "Sorry, my king..."
msgstr "申し訳ございません、王様..."

#. [objective]: condition=lose
#: war_and_home/utils/misc.cfg:6
msgid "Death of any loyal or leader unit, whether yours or allied"
msgstr "自軍・同盟軍を含む忠義・忠誠ユニットとリーダーの死亡"

